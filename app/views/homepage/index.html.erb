<div class="container mt-5">
  <div class="text-center">
    <h1 class="mb-4">List of All Work Locations</h1>
  </div>

  <% if current_user %>
    <div class="row mb-4">
      <div class="col text-center">
        <a href="/new/work_location" class="btn btn-primary">Add a New Place!</a>
      </div>
    </div>
  <% end %>

  <div class="row mb-4">
    <div class="col-md-6 mx-auto">
      <form action="/search_work_locations" method="get" class="d-flex">
        <input type="text" name="query" class="form-control me-2" placeholder="Enter address, zip code, or location" aria-label="Search">
        <button type="submit" class="btn btn-secondary">Search</button>
      </form>
    </div>
  </div>

  <div class="row">
    <% if @list_of_work_locations.present? %>
      <div class="table-responsive">
        <table class="table table-striped table-bordered">
          <thead class="table-dark">
            <tr>
              <th scope="col">Location Type</th>
              <th scope="col">Name</th>
              <th scope="col">Average Rating</th>
              <th scope="col">Distance (miles)</th>
              <th scope="col">Details</th>
            </tr>
          </thead>
          <tbody>
            <% @list_of_work_locations.each do |a_work_location| %>
              <tr>
                <td><%= a_work_location.type %></td>
                <td><%= a_work_location.name %></td>
                <td>
                  <% if Rating.where(location_id: a_work_location.id).exists? %>
                    <%= Rating.where(location_id: a_work_location.id).average(:stars).round(1) %>
                  <% else %>
                    N/A
                  <% end %>
                </td>
                <td>
                  <% if a_work_location.distance.present? %>
                    <%= a_work_location.distance.round(1) %> miles
                  <% else %>
                    N/A
                  <% end %>
                </td>
                <td>
                  <a href="/work_locations/<%= a_work_location.id %>" class="btn btn-sm btn-info">Show Details</a>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="alert alert-warning text-center" role="alert">
        No work locations found. Be the first to add one!
      </div>
    <% end %>
  </div>

  <% if @list_of_work_locations.empty? && params[:query].present? %>
    <div class="alert alert-warning text-center mt-4" role="alert">
      No locations match your search. Try again!
    </div>
  <% end %>
</div>

