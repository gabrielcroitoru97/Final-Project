<h1><%= action_name.capitalize %> Form Option</h1>

<%= form_with model: @form_option, url: admin_form_options_path, local: true do |f| %>
  <div class="mb-3">
    <%= f.label :name, "Option Name", class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :value, "Option Value", class: "form-label" %>
    <%= f.text_field :value, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :category, "Category", class: "form-label" %>
    <%= f.text_field :category, class: "form-control" %>
  </div>
  <%= f.submit "Save", class: "btn btn-primary" %>
<% end %>
