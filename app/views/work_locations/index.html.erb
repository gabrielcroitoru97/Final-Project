<div class="container mt-5">
  <!-- Title Section -->
  <div class="text-center mb-5">
    <h1 class="display-1" style="font-weight: 300; font-size: 5rem;">Work from Anywhere</h1>
  </div>

  <!-- Search Bar -->
<div class="row mb-5">
  <div class="col-md-8 mx-auto">
    <form action="/search_work_locations" method="get" class="d-flex flex-column align-items-center">
      <input 
        type="text" 
        name="query" 
        class="form-control mb-3" 
        placeholder="Enter address, zip code, or location" 
        aria-label="Search" 
        style="font-size: 1.5rem; padding: 1.25rem; border: 2px solid #6c757d; border-radius: 10px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
      <button 
        type="submit" 
        class="btn btn-primary btn-lg" 
        style="padding: 0.75rem 1.5rem; font-size: 1.25rem; border-radius: 10px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
        Search
      </button>
    </form>
  </div>
</div>


  <!-- Featured Images Section -->
  <div class="row text-center">
    <div class="col-lg-4 col-md-6 mb-4">
      <img src="<%= asset_path('featured_image1.jpg') %>" class="img-fluid rounded shadow-sm" alt="Featured Location 1" style="width: 100%; height: 250px; object-fit: cover;">
    </div>
    <div class="col-lg-4 col-md-6 mb-4">
      <img src="<%= asset_path('featured_image2.jpg') %>" class="img-fluid rounded shadow-sm" alt="Featured Location 2" style="width: 100%; height: 250px; object-fit: cover;">
    </div>
    <div class="col-lg-4 col-md-6 mb-4">
      <img src="<%= asset_path('featured_image3.jpg') %>" class="img-fluid rounded shadow-sm" alt="Featured Location 3" style="width: 100%; height: 250px; object-fit: cover;">
    </div>
    <div class="col-lg-4 col-md-6 mb-4">
      <img src="<%= asset_path('featured_image4.jpg') %>" class="img-fluid rounded shadow-sm" alt="Featured Location 4" style="width: 100%; height: 250px; object-fit: cover;">
    </div>
    <div class="col-lg-4 col-md-6 mb-4">
      <img src="<%= asset_path('featured_image5.png') %>" class="img-fluid rounded shadow-sm" alt="Featured Location 5" style="width: 100%; height: 250px; object-fit: cover;">
    </div>
    <div class="col-lg-4 col-md-6 mb-4">
      <img src="<%= asset_path('featured_image6.jpg') %>" class="img-fluid rounded shadow-sm" alt="Featured Location 6" style="width: 100%; height: 250px; object-fit: cover;">
    </div>
  </div>
</div>
