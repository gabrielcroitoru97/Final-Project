<div>
  <div>
    <h2>Edit Work Location</h2>

    <form action="/modify_work_location/<%= @the_work_location.id %>" method="post">
      <div>
        <label for="location_type_box">Location type</label>
        <select name="query_location_type_id" id="location_type_box">
          <% @loc_types.each do |item| %>
            <option value="<%= item.id %>" <%= "selected" if item.id == @the_work_location.location_type_id %>>
              <%= item.descriptor %>
            </option>
          <% end %>
        </select>
      </div>

      <div>
        <label for="name_box">Name</label>
        <input type="text" id="name_box" name="query_name" value="<%= @the_work_location.name %>">
      </div>

      <div>
        <label for="description_box">Description</label>
        <textarea id="description_box" name="query_description"><%= @the_work_location.description %></textarea>
      </div>

      <div>
        <label for="address_box">Address</label>
        <input type="text" id="address_box" name="query_address" value="<%= @the_work_location.address %>">
      </div>

      <div>
        <label for="city_box">City</label>
        <input type="text" id="city_box" name="query_city" value="<%= @the_work_location.city %>">
      </div>

      <div>
        <label for="state_box">State</label>
        <input type="text" id="state_box" name="query_state" value="<%= @the_work_location.state %>">
      </div>

      <div>
        <label for="zip_code_box">Zip code</label>
        <input type="text" id="zip_code_box" name="query_zip_code" value="<%= @the_work_location.zip_code %>">
      </div>

      <!-- Opening and Closing Times for Each Day -->
      <div>
        <h5>Opening and Closing Times</h5>
        <% ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"].each do |day| %>
          <div class="d-flex align-items-center mb-2">
            <label for="<%= day %>_opening_box" class="form-label me-3" style="width: 100px;">
              <%= day.capitalize %>
            </label>
            <input type="time" id="<%= day %>_opening_box" name="query_<%= day %>_opening" class="form-control me-2"
                   value="<%= @the_work_location.send("#{day}_opening") %>">
            <span class="me-2">to</span>
            <input type="time" id="<%= day %>_closing_box" name="query_<%= day %>_closing" class="form-control"
                   value="<%= @the_work_location.send("#{day}_closing") %>">
          </div>
        <% end %>
      </div>

      <div>
        <label for="phone_number_box">Phone number</label>
        <input type="text" id="phone_number_box" name="query_phone_number" value="<%= @the_work_location.phone_number %>">
      </div>

      <div>
        <label for="website_box">Website</label>
        <input type="text" id="website_box" name="query_website" value="<%= @the_work_location.website %>">
      </div>

      <div>
        <input type="checkbox" id="requires_purchase_box" name="query_requires_purchase" value="1"
               <%= "checked" if @the_work_location.requires_purchase %>>
        <label for="requires_purchase_box">Requires purchase</label>
      </div>

      <div>
        <input type="checkbox" id="membership_box" name="query_membership" value="1"
               <%= "checked" if @the_work_location.membership %>>
        <label for="membership_box">Membership</label>
      </div>

      <button>Update Work Location</button>
    </form>
  </div>
</div>
