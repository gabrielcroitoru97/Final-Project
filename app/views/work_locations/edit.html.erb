<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <h2 class="text-center mb-4">Edit Work Location</h2>

      <form action="/modify_work_location/<%= @the_work_location.id %>" method="post" class="p-4 border rounded shadow-sm bg-light">
        
        <!-- Location Type -->
        <div class="mb-3">
          <label for="location_type_box" class="form-label">Location Type<span class="text-danger">*</span></label>
          <select name="query_location_type_id" id="location_type_box" class="form-select">
            <% @loc_types.each do |item| %>
              <option value="<%= item.id %>" <%= "selected" if item.id == @the_work_location.location_type_id %>>
                <%= item.descriptor %>
              </option>
            <% end %>
          </select>
        </div>

        <!-- Name -->
        <div class="mb-3">
          <label for="name_box" class="form-label">Name <span class="text-danger">*</span></label>
          <input type="text" id="name_box" name="query_name" class="form-control" value="<%= @the_work_location.name %>">
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description_box" class="form-label">Description</label>
          <textarea id="description_box" name="query_description" rows="3" class="form-control"><%= @the_work_location.description %></textarea>
        </div>

        <!-- Address -->
        <div class="mb-3">
          <label for="address_box" class="form-label">Address <span class="text-danger">*</span></label>
          <input type="text" id="address_box" name="query_address" class="form-control" value="<%= @the_work_location.address %>">
        </div>

        <!-- City and State -->
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="city_box" class="form-label">City <span class="text-danger">*</span></label>
            <input type="text" id="city_box" name="query_city" class="form-control" value="<%= @the_work_location.city %>">
          </div>
          <div class="col-md-6 mb-3">
            <label for="state_box" class="form-label">State <span class="text-danger">*</span></label>
            <input type="text" id="state_box" name="query_state" class="form-control" value="<%= @the_work_location.state %>">
          </div>
        </div>

        <!-- Zip Code -->
        <div class="mb-3">
          <label for="zip_code_box" class="form-label">Zip Code <span class="text-danger">*</span></label>
          <input type="text" id="zip_code_box" name="query_zip_code" class="form-control" value="<%= @the_work_location.zip_code %>">
        </div>

        <!-- Opening and Closing Times -->
        <div class="mb-3">
          <h5>Opening and Closing Times</h5>
          <% ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"].each do |day| %>
            <div class="d-flex align-items-center mb-2">
              <label for="<%= day %>_opening_box" class="form-label me-3" style="width: 100px;"><%= day.capitalize %></label>
              <input type="time" id="<%= day %>_opening_box" name="query_<%= day %>_opening" class="form-control form-control-sm me-2 time-box" style="width: 100px;" value="<%= @the_work_location.send("\#{day}_opening") %>">
              <span class="me-2">to</span>
              <input type="time" id="<%= day %>_closing_box" name="query_<%= day %>_closing" class="form-control form-control-sm me-2 time-box" style="width: 100px;" value="<%= @the_work_location.send("\#{day}_closing") %>">

              <div class="ms-2 d-flex align-items-center">
                <input type="checkbox" id="<%= day %>_closed_box" name="query_<%= day %>_closed" value="1" class="form-check-input closed-checkbox" <%= @the_work_location.send("\#{day}_closed") ? 'checked' : '' %>>
                <label for="<%= day %>_closed_box" class="ms-2 form-label mb-0">Closed</label>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Phone Number -->
        <div class="mb-3">
          <label for="phone_number_box" class="form-label">Phone Number</label>
          <input type="text" id="phone_number_box" name="query_phone_number" class="form-control" value="<%= @the_work_location.phone_number %>">
        </div>

        <!-- Website -->
        <div class="mb-3">
          <label for="website_box" class="form-label">Website</label>
          <input type="text" id="website_box" name="query_website" class="form-control" value="<%= @the_work_location.website %>">
        </div>

        <!-- Requires Purchase -->
        <div class="form-check mb-3">
          <input type="checkbox" id="requires_purchase_box" name="query_requires_purchase" value="1" class="form-check-input" <%= "checked" if @the_work_location.requires_purchase %>>
          <label for="requires_purchase_box" class="form-check-label">Requires Purchase</label>
        </div>

        <!-- Membership -->
        <div class="form-check mb-4">
          <input type="checkbox" id="membership_box" name="query_membership" value="1" class="form-check-input" <%= "checked" if @the_work_location.membership %>>
          <label for="membership_box" class="form-check-label">Membership</label>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary w-100">Update Work Location</button>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const timeRows = document.querySelectorAll(".d-flex.align-items-center");

    timeRows.forEach(row => {
      const openingBox = row.querySelector("input[name*='opening']");
      const closingBox = row.querySelector("input[name*='closing']");
      const closedCheckbox = row.querySelector(".closed-checkbox");

      function toggleTimeInputs() {
        const isChecked = closedCheckbox.checked;
        openingBox.disabled = isChecked;
        closingBox.disabled = isChecked;

        if (isChecked) {
          openingBox.style.backgroundColor = '#e9ecef';
          openingBox.style.color = '#6c757d';
          closingBox.style.backgroundColor = '#e9ecef';
          closingBox.style.color = '#6c757d';
        } else {
          openingBox.style.backgroundColor = '';
          openingBox.style.color = '';
          closingBox.style.backgroundColor = '';
          closingBox.style.color = '';
        }
      }

      toggleTimeInputs();
      closedCheckbox.addEventListener("change", toggleTimeInputs);
    });
  });
</script>
