<div class="container mt-5">
  <div class="row">
    <div class="col-lg-8 mx-auto">
      <h2 class="text-center mb-4"> <%= @the_work_location.name.presence || "Location Details" %> </h2>

      <!-- Image Carousel -->
      <% location_images = Image.where(location_id: @the_work_location.id) %>
      <% if location_images.any? %>
        <div id="locationImageCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
          <div class="carousel-inner">
            <% location_images.each_with_index do |image, index| %>
              <% if image.picture.attached? %>
                <div class="carousel-item <%= 'active' if index == 0 %>">
                  <img src="<%= url_for(image.picture) %>" class="d-block w-100 rounded" alt="Location Image" style="max-height: 400px; object-fit: cover;">
                </div>
              <% end %>
            <% end %>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#locationImageCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#locationImageCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
        <a href="/images/<%= @the_work_location.id %>">Show All Images</a>
      <% else %>
        <div class="mb-4 text-center">
          <p>No images available for this location.</p>
        </div>
      <% end %>

      <% if current_user %>
        <form action="/insert_image/<%= @the_work_location.id %>" method="post" class="mb-4" enctype="multipart/form-data">
          <div class="mb-3">
            <label for="file_input" class="form-label">Upload Image</label>
            <input type="file" id="file_input" name="image_file" class="form-control">
          </div>
          <button type="submit" class="btn btn-primary">Upload Image</button>
        </form>
      <% end %>

      <!-- Location Details -->
      <% location_type = LocationType.find_by(id: @the_work_location.location_type_id) %>
      <table class="table table-bordered mb-4">
        <!-- Location details as before -->
      </table>

      <!-- Ratings Summary -->
      <div class="ratings-summary d-flex justify-content-around text-center mb-4">
        <!-- Ratings summary as before -->
      </div>

      <% if current_user && @the_work_location.owner_id == current_user.id %>
        <div class="d-flex justify-content-between mb-4">
          <a href="/edit_work_location/<%= @the_work_location.id %>" class="btn btn-warning">Edit Work Location</a>
          <a href="/delete_work_location/<%= @the_work_location.id %>" class="btn btn-danger">Delete Work Location</a>
        </div>
      <% end %>

      <!-- User Ratings Table -->
      <div class="table-responsive mb-4 text-center">
        <table class="table d-inline-block">
          <!-- Ratings table as before -->
        </table>
      </div>

      <!-- New Review Form -->
      <% if current_user %>
        <div class="card mb-4">
          <div class="card-header">
            <h5>Add a Review</h5>
          </div>
          <div class="card-body">
            <form action="/insert_rating/<%= @the_work_location.id %>" method="post">
              <div class="mb-3">
                <label for="rating_stars" class="form-label">Overall Rating (1-5)</label>
                <input type="number" id="rating_stars" name="query_stars" class="form-control" min="1" max="5" required>
              </div>

              <div class="mb-3">
                <label for="wifi_rating" class="form-label">Wifi Rating (1-5)</label>
                <input type="number" id="wifi_rating" name="query_wifi_rating" class="form-control" min="1" max="5" required>
              </div>

              <div class="mb-3">
                <label for="crowding_score" class="form-label">Crowding Score (1-5)</label>
                <input type="number" id="crowding_score" name="query_crowding_score" class="form-control" min="1" max="5" required>
              </div>

              <div class="mb-3">
                <label for="noise_level" class="form-label">Noise Level (1-5)</label>
                <input type="number" id="noise_level" name="query_noise_level" class="form-control" min="1" max="5" required>
              </div>

              <div class="mb-3">
                <label for="content_box" class="form-label">Comment</label>
                <textarea id="content_box" name="query_content" rows="3" class="form-control"></textarea>
              </div>

              <button type="submit" class="btn btn-success">Submit Review</button>
            </form>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Google Maps Embed --
      <% 
        latitude = @the_work_location.latitude
        longitude = @the_work_location.longitude
        gapi2 = "https://www.google.com/maps/embed/v1/place?key=AIzaSyBOmkmNEI6pvBlaQLHufHriV05FQruquo&q=#{latitude},#{longitude}"
      %>
<iframe
  width="100%"
  height="450"
  style="border:0"
  loading="lazy"
  allowfullscreen
  referrerpolicy="no-referrer-when-downgrade"
  src="<%= gapi2 %>">
</iframe>

<p>Generated URL: <%= gapi2.presence || "No URL Generated" %></p>

    </div>
  </div>
</div>
>
