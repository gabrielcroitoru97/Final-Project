<div class="container mt-5">
  <div class="row">
    <div class="col-lg-8 mx-auto">
      <h2 class="text-center mb-4"> <%= @the_work_location.name.presence || "Location Details" %> </h2>

      <!-- Image Carousel -->
      <% location_images = Image.where(location_id: @the_work_location.id) %>
      <% if location_images.any? %>
        <div id="locationImageCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
          <div class="carousel-inner">
            <% location_images.each_with_index do |image, index| %>
              <% if image.picture.attached? %>
                <div class="carousel-item <%= 'active' if index == 0 %>">
                  <img src="<%= url_for(image.picture) %>" class="d-block w-100 rounded" alt="Location Image" style="max-height: 400px; object-fit: cover;">
                </div>
              <% end %>
            <% end %>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#locationImageCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#locationImageCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
        <a href="/images/<%= @the_work_location.id %>">Show All Images</a>
      <% else %>
        <div class="mb-4 text-center">
          <p>No images available for this location.</p>
        </div>
      <% end %>

      <% if current_user %>
        <form action="/insert_image/<%= @the_work_location.id %>" method="post" class="mb-4" enctype="multipart/form-data">
          <div class="mb-3">
            <label for="file_input" class="form-label">Upload Image</label>
            <input type="file" id="file_input" name="image_file" class="form-control">
          </div>
          <button type="submit" class="btn btn-primary">Upload Image</button>
        </form>
      <% end %>

      <!-- Location Details -->
      <% location_type = LocationType.find_by(id: @the_work_location.location_type_id) %>
      <table class="table table-bordered mb-4">
        <tr><th>Location Type</th><td><%= location_type&.descriptor || "N/A" %></td></tr>
        <tr><th>Name</th><td><%= @the_work_location.name.presence || "N/A" %></td></tr>
        <tr><th>Description</th><td><%= @the_work_location.description.presence || "N/A" %></td></tr>
        <tr><th>Address</th><td><%= @the_work_location.address.presence || "N/A" %></td></tr>
        <tr><th>City</th><td><%= @the_work_location.city.presence || "N/A" %></td></tr>
        <tr><th>State</th><td><%= @the_work_location.state.presence || "N/A" %></td></tr>
        <tr><th>Zip Code</th><td><%= @the_work_location.zip_code.presence || "N/A" %></td></tr>
        <tr>
          <th>Phone Number</th>
          <td>
            <%= @the_work_location.phone_number&.gsub(/(\d{3})(\d{3})(\d{4})/, '(\1)\2-\3') || "N/A" %>
          </td>
        </tr>
        <tr><th>Website</th><td><%= @the_work_location.website.present? ? link_to(@the_work_location.website, @the_work_location.website, target: "_blank") : "N/A" %></td></tr>
        <tr><th>Requires Purchase</th><td><%= @the_work_location.requires_purchase ? "Yes" : "No" %></td></tr>
        <tr><th>Membership</th><td><%= @the_work_location.membership ? "Yes" : "No" %></td></tr>
        <!-- Opening and Closing Times for Each Day -->
        <tr><th colspan="2" class="text-center">Opening and Closing Hours</th></tr>
        <% ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"].each do |day| %>
          <tr>
            <th><%= day %></th>
            <td>
              <% opening = @the_work_location.send("#{day.downcase}_opening") %>
              <% closing = @the_work_location.send("#{day.downcase}_closing") %>
              <% closed = @the_work_location.send("#{day.downcase}_closed") %>

              <% if closed %>
                Closed
              <% elsif opening.nil? && closing.nil? %>
                <!-- Blank when both are empty -->
              <% else %>
                <%= opening.strftime("%I:%M %P") if opening %> - <%= closing.strftime("%I:%M %P") if closing %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>

      <!-- Review Section -->
       <!-- Review Section -->
      <% if current_user && current_user.id != @the_work_location.owner_id && !@ratings.exists?(user_id: current_user.id) %>
        <div class="mb-4 p-3 border rounded bg-light">
          <h5 class="mb-3">Add Your Review</h5>
          <form action="/insert_rating/<%= @the_work_location.id %>" method="post">
            <!-- Hidden fields for user and location IDs -->
            <input type="hidden" name="query_user_id" value="<%= current_user.id %>">
            <input type="hidden" name="query_location_id" value="<%= @the_work_location.id %>">

            <div class="d-flex justify-content-between mb-2">
              <div class="me-2">
                <label for="stars_select" class="form-label">Overall</label>
                <select id="stars_select" name="query_stars" class="form-select" required>
                  <% (1..5).each do |i| %>
                    <option value="<%= i %>"><%= i %></option>
                  <% end %>
                </select>
              </div>
              <div class="me-2">
                <label for="wifi_select" class="form-label">Wifi</label>
                <select id="wifi_select" name="query_wifi_rating" class="form-select" required>
                  <% (1..5).each do |i| %>
                    <option value="<%= i %>"><%= i %></option>
                  <% end %>
                </select>
              </div>
              <div class="me-2">
                <label for="crowding_select" class="form-label">Crowding</label>
                <select id="crowding_select" name="query_crowding_score" class="form-select" required>
                  <% (1..5).each do |i| %>
                    <option value="<%= i %>"><%= i %></option>
                  <% end %>
                </select>
              </div>
              <div>
                <label for="noise_select" class="form-label">Noise</label>
                <select id="noise_select" name="query_noise_level" class="form-select" required>
                  <% (1..5).each do |i| %>
                    <option value="<%= i %>"><%= i %></option>
                  <% end %>
                </select>
              </div>
            </div>
            <div class="mb-3">
              <label for="content_input" class="form-label">Comment</label>
              <textarea id="content_input" name="query_content" rows="2" class="form-control" required></textarea>
            </div>
            <button type="submit" class="btn btn-success">Submit Review</button>
          </form>
        </div>
      <% end %>


      <!-- Ratings Summary -->
      <% avg_ratings = {
           stars: Rating.where(location_id: @the_work_location.id).average(:stars),
           wifi: Rating.where(location_id: @the_work_location.id).average(:wifi_rating),
           crowding: Rating.where(location_id: @the_work_location.id).average(:crowding_score),
           noise: Rating.where(location_id: @the_work_location.id).average(:noise_level)
      }.transform_values { |v| v&.round(1) || 0 } %>

      <div class="ratings-summary d-flex justify-content-around text-center mb-4">
        <div class="rating-item">
          <h5>Overall</h5>
          <p class="display-6 text-primary"><%= avg_ratings[:stars] %> / 5</p>
        </div>
        <div class="rating-item">
          <h5>Wifi</h5>
          <p class="display-6 text-primary"><%= avg_ratings[:wifi] %> / 5</p>
        </div>
        <div class="rating-item">
          <h5>Crowding</h5>
          <p class="display-6 text-primary"><%= avg_ratings[:crowding] %> / 5</p>
        </div>
        <div class="rating-item">
          <h5>Noise</h5>
          <p class="display-6 text-primary"><%= avg_ratings[:noise] %> / 5</p>
        </div>
      </div>

      <% if current_user && @the_work_location.owner_id == current_user.id %>
        <div class="d-flex justify-content-between mb-4">
          <a href="/edit_work_location/<%= @the_work_location.id %>" class="btn btn-warning">Edit Work Location</a>
          <a href="/delete_work_location/<%= @the_work_location.id %>" class="btn btn-danger">Delete Work Location</a>
        </div>
      <% end %>

      <!-- User Ratings Table -->
      <div class="table-responsive mb-4 text-center">
        <table class="table d-inline-block">
          <thead>
            <tr>
              <th>User</th>
              <th>Overall</th>
              <th>Wifi</th>
              <th>Crowding</th>
              <th>Noise</th>
              <th>Comment</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @ratings.each do |a_rating| %>
              <tr>
                <td><%= a_rating.user.email %></td>
                <% [:stars, :wifi_rating, :crowding_score, :noise_level].each do |field| %>
                  <td style="min-width: 100px;">
                    <%= a_rating.send(field) %> / 5
                  </td>
                <% end %>
                <td><%= a_rating.content %></td>
                <td>
                  <% if current_user && a_rating.user_id == current_user.id %>
                    <a href="/delete_rating/<%= a_rating.id %>" class="btn btn-sm btn-danger">Delete</a>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

<!-- Google Maps Embed --
      <% 
        latitude = @the_work_location.latitude
        longitude = @the_work_location.longitude
        gapi2 = "https://www.google.com/maps/embed/v1/place?key=AIzaSyBOmkmNEI6pvBlaQLHufHriV05FQruquo&q=#{latitude},#{longitude}"
      %>
<iframe
  width="100%"
  height="450"
  style="border:0"
  loading="lazy"
  allowfullscreen
  referrerpolicy="no-referrer-when-downgrade"
  src="<%= gapi2 %>">
</iframe>

<p>Generated URL: <%= gapi2.presence || "No URL Generated" %></p>

    </div>
  </div>
</div>
>
