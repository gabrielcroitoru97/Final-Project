<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <h2 class="text-center mb-4">Add a New Work Location</h2>

      <form action="/insert_work_location" method="post" class="p-4 border rounded shadow-sm bg-light">
        <div class="mb-3">
          <label for="location_type_box" class="form-label">Location Type</label>
          <select name="query_location_type" id="location_type_box" class="form-select">
            <% @loc_types.each do |item| %>
              <option value="<%= item.id %>"><%= item.descriptor %></option>
            <% end %>
          </select>
        </div>

        <div class="mb-3">
          <label for="name_box" class="form-label">Name</label>
          <input type="text" id="name_box" name="query_name" class="form-control">
        </div>

        <div class="mb-3">
          <label for="address_box" class="form-label">Address</label>
          <input type="text" id="address_box" name="query_address" class="form-control">
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="weekday_opening_box" class="form-label">Weekday Opening</label>
            <input type="time" id="weekday_opening_box" name="query_weekday_opening" class="form-control">
          </div>
          <div class="col-md-6 mb-3">
            <label for="weekday_closing_box" class="form-label">Weekday Closing</label>
            <input type="time" id="weekday_closing_box" name="query_weekday_closing" class="form-control">
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="weekend_opening_box" class="form-label">Weekend Opening</label>
            <input type="time" id="weekend_opening_box" name="query_weekend_opening" class="form-control">
          </div>
          <div class="col-md-6 mb-3">
            <label for="weekend_closing_box" class="form-label">Weekend Closing</label>
            <input type="time" id="weekend_closing_box" name="query_weekend_closing" class="form-control">
          </div>
        </div>

        <div class="mb-3">
          <label for="phone_number_box" class="form-label">Phone Number</label>
          <input type="text" id="phone_number_box" name="query_phone_number" class="form-control">
        </div>

        <div class="mb-3">
          <label for="website_box" class="form-label">Website</label>
          <input type="text" id="website_box" name="query_website" class="form-control">
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="city_box" class="form-label">City</label>
            <input type="text" id="city_box" name="query_city" class="form-control">
          </div>
          <div class="col-md-6 mb-3">
            <label for="state_box" class="form-label">State</label>
            <input type="text" id="state_box" name="query_state" class="form-control">
          </div>
        </div>

        <div class="mb-3">
          <label for="zip_code_box" class="form-label">Zip Code</label>
          <input type="text" id="zip_code_box" name="query_zip_code" class="form-control">
        </div>

        <div class="mb-3">
          <label for="description_box" class="form-label">Description</label>
          <textarea id="description_box" name="query_description" rows="3" class="form-control"></textarea>
        </div>

        <div class="form-check mb-3">
          <input type="checkbox" id="requires_purchase_box" name="query_requires_purchase" value="1" class="form-check-input">
          <label for="requires_purchase_box" class="form-check-label">Requires Purchase</label>
        </div>

        <div class="form-check mb-4">
          <input type="checkbox" id="membership_box" name="query_membership" value="1" class="form-check-input">
          <label for="membership_box" class="form-check-label">Membership</label>
        </div>

        <button type="submit" class="btn btn-primary w-100">Create Work Location</button>
      </form>
    </div>
  </div>
</div>
