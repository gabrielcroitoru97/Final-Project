<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <h2 class="text-center mb-4">Add a New Work Location</h2>

      <form action="/insert_work_location" method="post" class="p-4 border rounded shadow-sm bg-light">
        <div class="mb-3">
          <label for="location_type_box" class="form-label">Location Type<span class="text-danger">*</span></label>
          <select name="query_location_type" id="location_type_box" class="form-select">
            <% @loc_types.each do |item| %>
              <option value="<%= item.id %>"><%= item.descriptor %></option>
            <% end %>
          </select>
        </div>

        <div class="mb-3">
          <label for="name_box" class="form-label">Name <span class="text-danger">*</span></label>
          <input type="text" id="name_box" name="query_name" class="form-control">
          <div id="name_error" class="text-danger mt-2" style="display: none;">
            Name is required.
          </div>
        </div>

        <div class="mb-3">
          <label for="address_box" class="form-label">Address <span class="text-danger">*</span></label>
          <input type="text" id="address_box" name="query_address" class="form-control">
          <div id="address_error" class="text-danger mt-2" style="display: none;">
            Address is required.
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="city_box" class="form-label">City <span class="text-danger">*</span></label>
            <input type="text" id="city_box" name="query_city" class="form-control">
            <div id="city_error" class="text-danger mt-2" style="display: none;">
              City is required.
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label for="state_box" class="form-label">State <span class="text-danger">*</span></label>
            <input type="text" id="state_box" name="query_state" class="form-control">
            <div id="state_error" class="text-danger mt-2" style="display: none;">
              State is required.
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label for="zip_code_box" class="form-label">Zip Code <span class="text-danger">*</span></label>
          <input type="text" id="zip_code_box" name="query_zip_code" class="form-control">
          <div id="zip_code_error" class="text-danger mt-2" style="display: none;">
            Zip Code is required.
          </div>
        </div>

        <!-- Opening and Closing Times for Each Day -->
        <div class="mb-3">
          <h5>Opening and Closing Times</h5>
          <% ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"].each do |day| %>
            <div class="d-flex align-items-center mb-2">
              <label for="<%= day.downcase %>_opening_box" class="form-label me-3" style="width: 100px;"><%= day %></label>
              <input type="time" id="<%= day.downcase %>_opening_box" name="query_<%= day.downcase %>_opening"
                    class="form-control form-control-sm me-2 time-box" style="width: 100px;">
              <span class="me-2">to</span>
              <input type="time" id="<%= day.downcase %>_closing_box" name="query_<%= day.downcase %>_closing"
                    class="form-control form-control-sm me-2 time-box" style="width: 100px;">
              <div class="ms-2 d-flex align-items-center">
                <input type="checkbox" id="<%= day.downcase %>_closed_box" name="query_<%= day.downcase %>_closed" value="1"
                      class="form-check-input closed-checkbox">
                <label for="<%= day.downcase %>_closed_box" class="ms-2 form-label mb-0">Closed</label>
              </div>
            </div>
          <% end %>
        </div>

        <div class="mb-3">
          <label for="phone_number_box" class="form-label">Phone Number</label>
          <input
            type="text"
            id="phone_number"
            name="query_phone_number"
            class="form-control"
            placeholder="(xxx) xxx-xxxx"
            maxlength="14"
          >
          <div id="phone_number_error" class="text-danger mt-2" style="display: none;">
            Phone number must be exactly 10 digits.
          </div>
        </div>

        <div class="mb-3">
          <label for="website_box" class="form-label">Website</label>
          <input type="text" id="website_box" name="query_website" class="form-control">
        </div>

        <div class="mb-3">
          <label for="description_box" class="form-label">Description</label>
          <textarea id="description_box" name="query_description" rows="3" class="form-control"></textarea>
        </div>

        <div class="form-check mb-3">
          <input type="checkbox" id="requires_purchase_box" name="query_requires_purchase" value="1" class="form-check-input">
          <label for="requires_purchase_box" class="form-check-label">Requires Purchase</label>
        </div>

        <div class="form-check mb-4">
          <input type="checkbox" id="membership_box" name="query_membership" value="1" class="form-check-input">
          <label for="membership_box" class="form-check-label">Membership</label>
        </div>

        <button type="submit" class="btn btn-primary w-100">Create Work Location</button>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Handle disabling/enabling time inputs based on the 'Closed' checkbox
    const timeRows = document.querySelectorAll(".d-flex.align-items-center");

    timeRows.forEach(row => {
      const openingBox = row.querySelector("input[name*='opening']");
      const closingBox = row.querySelector("input[name*='closing']");
      const closedCheckbox = row.querySelector(".closed-checkbox");

      // Toggle function
      function toggleTimeInputs() {
        const isChecked = closedCheckbox.checked;
        openingBox.disabled = isChecked;
        closingBox.disabled = isChecked;

        // Force inline style
        if (isChecked) {
          openingBox.style.backgroundColor = '#e9ecef';
          openingBox.style.color = '#6c757d';
          closingBox.style.backgroundColor = '#e9ecef';
          closingBox.style.color = '#6c757d';
        } else {
          openingBox.style.backgroundColor = '';
          openingBox.style.color = '';
          closingBox.style.backgroundColor = '';
          closingBox.style.color = '';
        }
      }

      // Initialize state
      toggleTimeInputs();

      // Add event listener
      closedCheckbox.addEventListener("change", toggleTimeInputs);
    });

    // Phone number formatting
    const phoneNumberInput = document.getElementById("phone_number");

    phoneNumberInput.addEventListener("input", function () {
      let input = phoneNumberInput.value.replace(/\D/g, ''); // Remove non-digits
      if (input.length > 10) input = input.slice(0, 10); // Limit to 10 digits

      // Format input as (xxx) xxx-xxxx
      const formattedNumber = input.length > 6
        ? `(${input.slice(0, 3)}) ${input.slice(3, 6)}-${input.slice(6)}`
        : input.length > 3
          ? `(${input.slice(0, 3)}) ${input.slice(3)}`
          : input.length > 0
            ? `(${input}`
            : '';

      phoneNumberInput.value = formattedNumber;
    });

    // Form validation script
    const form = document.querySelector("form");
    const requiredFields = [
      { id: "name_box", errorId: "name_error" },
      { id: "address_box", errorId: "address_error" },
      { id: "city_box", errorId: "city_error" },
      { id: "state_box", errorId: "state_error" },
      { id: "zip_code_box", errorId: "zip_code_error" }
    ];

    form.addEventListener("submit", function (event) {
      let isValid = true;

      requiredFields.forEach(({ id, errorId }) => {
        const input = document.getElementById(id);
        const errorDiv = document.getElementById(errorId);

        if (!input.value.trim()) {
          event.preventDefault();
          errorDiv.style.display = "block";
          isValid = false;
        } else {
          errorDiv.style.display = "none";
        }
      });

      const phoneNumberError = document.getElementById("phone_number_error");
      const phoneNumber = phoneNumberInput.value.replace(/\D/g, "");

      if (phoneNumber.length !== 10) {
        event.preventDefault();
        phoneNumberError.style.display = "block";
        isValid = false;
      } else {
        phoneNumberError.style.display = "none";
      }

      return isValid;
    });
  });
</script>

<style>
  /* Extra styling for disabled time inputs; you can tweak if needed */
  input[type='time'][disabled] {
    cursor: not-allowed;
  }
</style>
