<div class="container mt-5">
  <h1 class="text-center mb-4">Contact Us</h1>

  <%= form_with model: @contact_request, local: true do |form| %>
    <div class="mb-3">
      <%= form.label :name, class: 'form-label' %>
      <%= form.text_field :name, class: 'form-control', placeholder: 'Your Name', required: true %>
    </div>

    <div class="mb-3">
      <%= form.label :email, class: 'form-label' %>
      <%= form.email_field :email, class: 'form-control', placeholder: 'Your Email', required: true %>
    </div>

    <div class="mb-3">
      <%= form.label :message, class: 'form-label' %>
      <%= form.text_area :message, class: 'form-control', placeholder: 'Your Message', rows: 5, required: true %>
    </div>

    <div class="text-center">
      <%= form.submit 'Send Message', class: 'btn btn-primary btn-lg' %>
    </div>
  <% end %>
</div>
